---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { getNotes, noteHref, formatDate } from '@/lib/content';
const all = await getNotes();
---

<Base title="Field Notes" current="notes">
  <div class="page wrap">
    <header class="page-head">
      <p class="label"><a class="link-underline" href="/#field-notes">03 — Field Notes</a></p>
      <h1 class="page-title">All field notes</h1>
    </header>
    <ul class="n-grid">
      {all.map((n) => (
        <li>
          <a href={noteHref(n)} class="n-card">
            <Image src={n.data.cover} alt={n.data.coverAlt} widths={[480, 800]} sizes="(max-width: 640px) 100vw, 33vw" class="n-img" />
            <span class="n-title">{n.data.title}</span>
            <span class="meta">{formatDate(n.data.date)}{n.data.location && ` / ${n.data.location}`}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .n-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 48px 32px; }
  .n-card { display: grid; gap: 4px; }
  :global(.n-img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; margin-bottom: 10px; filter: grayscale(1); transition: filter var(--t-photo) var(--ease); }
  .n-card:hover :global(.n-img), .n-card:focus-visible :global(.n-img) { filter: none; }
  .n-title { font-size: 15px; }
</style>
