---
/**
 * The About content, shared by the homepage section (03 — About) and the /about/ page
 * so both always look the same: the FluidGlass name panel, then details and biography.
 */
import { render } from 'astro:content';
import FluidGlass from '@/components/reactbits/FluidGlass';
import { getProfile, paragraphs, inlineMd } from '@/lib/content';
import { t as tr, langFromUrl, localePath, pick } from '@/i18n/ui';

const lang = langFromUrl(Astro.url);
const t = tr(lang);
const profile = await getProfile();
const { Content } = await render(profile);
const d = profile.data;
const zhBio = lang === 'zh' ? paragraphs(d.zh?.body) : [];
const role = pick(d, 'role', lang);
const field = pick(d, 'researchField', lang) ?? t.about.toBeSupplied;
const affiliation = pick(d, 'affiliation', lang) ?? t.about.toBeSupplied;

/**
 * Research themes arranged in an oval around "Quantum Optics" in the glass panel.
 * x, y: centre of each word as fractions of the panel; size: relative to "Quantum Optics".
 * Rows get narrower towards the top and bottom so the cloud's outline reads as an oval.
 * Colours group the themes: atoms & arrays (#017288), molecules (amber), field (sage).
 * Colours are softened and partly transparent so the glass reads through them.
 */
const ATOMS = '#017288';
const MOLECULES = '#c08a62';
const FIELD = '#6f8f7d';
const cloud = [
  { text: 'Atom Arrays', x: 0.5, y: 0.15, size: 0.3, weight: 500, color: ATOMS, opacity: 0.53 },
  { text: 'AMO Physics', x: 0.37, y: 0.245, size: 0.4, weight: 600, color: FIELD, opacity: 0.72, stroke: 2 },
  { text: 'Optical tweezers', x: 0.655, y: 0.25, size: 0.22, weight: 400, color: ATOMS, opacity: 0.5 },
  { text: 'Ultracold Polar Molecules', x: 0.5, y: 0.335, size: 0.26, weight: 500, color: MOLECULES, opacity: 0.68 },
  { text: 'Rydberg Atom Quantum Simulation', x: 0.5, y: 0.675, size: 0.25, weight: 500, color: ATOMS, opacity: 0.6 },
  { text: 'Microwave Shielding', x: 0.385, y: 0.765, size: 0.34, weight: 600, color: MOLECULES, opacity: 0.9, stroke: 1.5 },
  { text: 'Dipolar Fermi Gases', x: 0.705, y: 0.76, size: 0.21, weight: 400, color: FIELD, opacity: 0.55 },
  { text: 'Neutral-atom Quantum Computing', x: 0.5, y: 0.85, size: 0.2, weight: 400, color: ATOMS, opacity: 0.48 },
];

/** Chinese cloud: same oval, sizes nudged for the denser CJK glyphs. */
const cloudZh = [
  { text: '原子阵列', x: 0.5, y: 0.15, size: 0.3, weight: 500, color: ATOMS, opacity: 0.62 },
  { text: 'AMO 物理', x: 0.38, y: 0.245, size: 0.38, weight: 600, color: FIELD, opacity: 0.72 },
  { text: '光镊', x: 0.635, y: 0.25, size: 0.26, weight: 400, color: ATOMS, opacity: 0.5 },
  { text: '超冷极性分子', x: 0.5, y: 0.335, size: 0.26, weight: 500, color: MOLECULES, opacity: 0.68 },
  { text: '里德堡原子量子模拟', x: 0.5, y: 0.675, size: 0.25, weight: 500, color: ATOMS, opacity: 0.6 },
  { text: '微波屏蔽', x: 0.4, y: 0.765, size: 0.34, weight: 600, color: MOLECULES, opacity: 0.9, stroke: 1.2 },
  { text: '偶极费米气体', x: 0.66, y: 0.76, size: 0.22, weight: 400, color: MOLECULES, opacity: 0.55 },
  { text: '中性原子量子计算', x: 0.5, y: 0.85, size: 0.21, weight: 400, color: ATOMS, opacity: 0.48 },
];

---

<div class="about-glass">
  <FluidGlass
    client:visible
    text={lang === 'zh' ? '量子光学' : 'Quantum Optics'}
    textWidth={lang === 'zh' ? 0.48 : 0.84}
    cloud={lang === 'zh' ? cloudZh : cloud}
    textStroke={2}
    background="#f8f8f5"
    shape="torus"
    size={210}
    position={[0.86, 0.19]}
    positionNarrow={[0.15, 0.12]}
    refraction={0.7}
    dispersion={0.18}
    interaction="follow"
    frost={0}
    color="#ffffff"
    tint={0}
    reflection={1}
    shadow={0.5}
    elevation={0.4}
    smoothness={0.5}
    wobble={0.5}
    spin={0.3}
    idle
    morphOnClick
    intro
  />
</div>
<div class="about-grid">
  <dl class="dl">
    <dt>{t.about.role}</dt><dd>{role}</dd>
    <dt>{t.about.field}</dt><dd>{field}</dd>
    <dt>{t.about.affiliation}</dt><dd>{affiliation}</dd>
    <dt>{t.about.scholar}</dt>
    <dd>
      {d.scholar ? <a class="link-underline tap" href={d.scholar} rel="noopener">{t.about.scholarLink}</a> : t.about.toBeSupplied}
    </dd>
    <dt>{t.about.cv}</dt>
    <dd>{d.cv ? <a class="link-underline tap" href={d.cv}>{t.about.cvLink}</a> : t.about.toBeSupplied}</dd>
    {d.links.length > 0 && (
      <>
        <dt>{t.about.links}</dt>
        <dd><ul class="links">{d.links.map((l) => <li><a class="link-underline" href={l.href}>{l.label}</a></li>)}</ul></dd>
      </>
    )}
  </dl>
  <div>
    <div class="prose">{zhBio.length ? zhBio.map((p) => <p set:html={inlineMd(p)} />) : <Content />}</div>
    <p class="meta continue">
      {lang === 'zh' ? (
        <>{t.about.continue[0]}{' '}<a class="link-underline tap" href={localePath(lang, '/#research')}>{t.about.continue[1]}</a>、<a class="link-underline tap" href={localePath(lang, '/publications/')}>{t.about.continue[2]}</a>{' '}{t.about.continue[3]}{' '}<a class="link-underline tap" href={localePath(lang, '/notes/')}>{t.about.continue[4]}</a>。</>
      ) : (
        <>{t.about.continue[0]}{' '}<a class="link-underline tap" href={localePath(lang, '/#research')}>{t.about.continue[1]}</a>,{' '}<a class="link-underline tap" href={localePath(lang, '/publications/')}>{t.about.continue[2]}</a>{' '}{t.about.continue[3]}{' '}<a class="link-underline tap" href={localePath(lang, '/notes/')}>{t.about.continue[4]}</a>.</>
      )}
    </p>
  </div>
</div>

<style>
  .about-glass {
    position: relative;
    width: 100%;
    /* Scales with the width so the word cloud keeps its oval proportions. */
    height: clamp(320px, 43vw, 600px);
    margin-bottom: clamp(12px, 2vh, 28px);
  }
  .about-grid { display: grid; grid-template-columns: minmax(240px, 30%) 1fr; gap: 56px; align-items: start; }
  .links { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .continue { margin-top: 40px; }
  /* Phones: a taller panel opens a clear corner above the cloud where the lens rests. */
  @media (max-width: 560px) { .about-glass { height: 430px; } }
  @media (max-width: 800px) { .about-grid { grid-template-columns: 1fr; gap: 32px; } }
</style>
