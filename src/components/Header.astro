---
import { getProfile } from '@/lib/content';
import { t as tr, langFromUrl, localePath, alternatePath, pick } from '@/i18n/ui';

interface Props {
  current?: 'research' | 'publications' | 'about' | 'notes';
}
const { current } = Astro.props;
const lang = langFromUrl(Astro.url);
const t = tr(lang);
const profile = await getProfile();
const d = profile.data;
const name = pick(d, 'name', lang);
const identity = pick(d, 'headline', lang) ?? pick(d, 'role', lang);
const home = localePath(lang, '/');
const other = alternatePath(lang, Astro.url.pathname);

const items = [
  { key: 'research', label: t.nav.research, href: `${home}#research` },
  { key: 'publications', label: t.nav.publications, href: `${home}#publications` },
  { key: 'about', label: t.nav.about, href: `${home}#about` },
  { key: 'notes', label: t.nav.notes, href: `${home}#field-notes` },
] as const;
---

<header class="site-header" data-header>
  <div class="site-header__inner wrap">
    <a class="site-header__id" href={home} aria-label={`${name}, ${t.home}`}>
      <span class="site-header__name">{name}</span>
      <span class="site-header__role">{identity}</span>
    </a>
    <nav aria-label={t.navLabel} class="site-header__nav">
      <ul class="site-nav">
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              data-nav={item.key}
              aria-current={current === item.key ? 'page' : undefined}
              class:list={['site-nav__link', { 'is-active': current === item.key }]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        class="site-lang"
        href={other.href}
        hreflang={other.lang === 'zh' ? 'zh-CN' : 'en'}
        lang={other.lang === 'zh' ? 'zh-CN' : 'en'}
        aria-label={t.switchLabel}
        data-lang-switch
      >{t.switchTo}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: var(--bg);
    transition: box-shadow var(--t-fast) var(--ease);
  }
  .site-header.is-scrolled { box-shadow: 0 1px 0 var(--rule); }
  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding-top: 26px;
  }
  .site-header__id { display: grid; gap: 4px; }
  .site-header__name {
    font-family: var(--mono);
    font-size: 14px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .site-header__role {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.02em;
  }
  .site-nav {
    list-style: none;
    display: flex;
    gap: clamp(16px, 2.4vw, 40px);
    margin: 0;
    padding: 0;
  }
  .site-nav__link {
    display: inline-block;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.03em;
    color: var(--ink-2);
    padding: 2px 0 4px;
    background-image: linear-gradient(var(--ink), var(--ink));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
  }
  .site-nav__link:hover { color: var(--ink); }
  .site-header__nav { display: flex; align-items: flex-start; gap: clamp(16px, 2.4vw, 40px); }
  .site-lang {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.03em;
    color: var(--muted);
    padding: 1px 7px 3px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
    white-space: nowrap;
  }
  .site-lang:hover { color: var(--ink); border-color: var(--faint); }
  .site-nav__link.is-active { color: var(--ink); background-size: 100% 1px; }

  @media (max-width: 720px) {
    .site-header__inner { flex-direction: column; gap: 10px; padding-top: 14px; }
    .site-header__role { display: none; }
    .site-nav { gap: 18px; }
    .site-nav__link { font-size: 13px; padding-block: 13px 12px; }
    .site-nav { gap: 16px; }
    .site-nav__link { white-space: nowrap; }
    /* The language switch sits opposite the name, so the nav row keeps its full width. */
    .site-header__inner { position: relative; }
    .site-lang { position: absolute; top: 4px; right: var(--gutter, 20px); padding: 3px 10px 4px; font-size: 13px; }
    /* Invisible padding brings the switch to a 44px touch target. */
    .site-lang::after { content: ''; position: absolute; inset: -10px -8px; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 4);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // On the homepage, mark the section currently in view.
  const sections = ['research', 'publications', 'about', 'field-notes']
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => !!el);
  if (sections.length) {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
    const keyFor: Record<string, string> = { research: 'research', publications: 'publications', about: 'about', 'field-notes': 'notes' };
    const update = () => {
      // A section becomes current once its top has passed a line 40% of the way down the
      // visible area, i.e. once it clearly fills most of the screen; at the very bottom of
      // the page the last section wins.
      const top = header?.offsetHeight ?? 0;
      const vh = window.innerHeight;
      const line = top + (vh - top) * 0.4;
      let active = '';
      for (const s of sections) {
        const r = s.getBoundingClientRect();
        if (r.top <= line && r.bottom > top) active = keyFor[s.id];
      }
      if (window.scrollY + vh >= document.documentElement.scrollHeight - 4) active = keyFor[sections[sections.length - 1].id];
      if (sections[0].getBoundingClientRect().top > vh * 0.5) active = '';
      links.forEach((a) => {
        const on = a.dataset.nav === active;
        a.classList.toggle('is-active', on);
        if (on) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);

    // Same-page navigation: a short, eased scroll to the section. Long trips first jump to
    // just short of the destination, so the research timeline is never played through.
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let raf = 0;
    const cancel = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };
    ['wheel', 'touchstart', 'keydown'].forEach((t) => window.addEventListener(t, cancel, { passive: true }));

    const scrollToY = (to: number) => {
      cancel();
      const max = document.documentElement.scrollHeight - window.innerHeight;
      to = Math.max(0, Math.min(max, to));
      if (reduce.matches) {
        window.scrollTo({ top: to, behavior: 'instant' as ScrollBehavior });
        return;
      }
      const vh = window.innerHeight;
      const lead = vh * 0.6;
      let from = window.scrollY;
      if (Math.abs(to - from) > lead) {
        from = to + (to > from ? -lead : lead);
        window.scrollTo({ top: from, behavior: 'instant' as ScrollBehavior });
      }
      const dist = to - from;
      const dur = 700;
      const t0 = performance.now();
      const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
      const step = (now: number) => {
        const t = Math.min(1, (now - t0) / dur);
        window.scrollTo({ top: from + dist * ease(t), behavior: 'instant' as ScrollBehavior });
        raf = t < 1 ? requestAnimationFrame(step) : 0;
      };
      raf = requestAnimationFrame(step);
    };

    links.forEach((a) => {
      a.addEventListener('click', (e) => {
        const url = new URL(a.href);
        const hash = url.hash.slice(1);
        const target = hash && document.getElementById(hash);
        if (!target || url.pathname !== location.pathname) return;
        e.preventDefault();
        const top = target.getBoundingClientRect().top + window.scrollY - (header?.offsetHeight ?? 0);
        scrollToY(top);
        history.pushState(null, '', `#${hash}`);
        target.focus({ preventScroll: true });
      });
    });
  }
</script>
